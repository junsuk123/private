# Keep live trading disabled unless a later phase explicitly implements approval flows.
APP_ENV=local
DATA_ENV=live
TRADING_MODE=read_only
LIVE_TRADING_ENABLED=false

# Future integrations should load secrets from environment variables or a secret manager.
OPENDART_API_KEY=
FRED_API_KEY=
ECOS_API_KEY=
BROKER_API_KEY=
BROKER_API_SECRET=

# Korea Investment & Securities Open API (KIS Developers).
# Paper mode uses https://openapivts.koreainvestment.com:29443 and live mode uses
# https://openapi.koreainvestment.com:9443. Keep KIS_LIVE_ENABLED=false until
# manual approval and risk gates are intentionally enabled.
KIS_LIVE_ENABLED=false
KIS_PAPER_TRADING=true
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_ACCOUNT_PRODUCT_CODE=01
KIS_TIMEOUT_SECONDS=10

# Optional LLM event/news classifier. If disabled or unavailable, keyword fallback is used.
LLM_EVENT_CLASSIFIER_ENABLED=false
LLM_EVENT_PROVIDER=local
LLM_EVENT_MODEL=qwen2.5:1.5b-instruct
LLM_EVENT_API_KEY=
LLM_EVENT_LOCAL_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
LLM_EVENT_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_EVENT_MAX_ITEMS_PER_SOURCE=1
LLM_EVENT_MAX_ITEMS_PER_RUN=3
LIVE_RESEARCH_COLLECTION_INTERVAL_SECONDS=180
LIVE_EVENT_EVIDENCE_TTL_HOURS=24
MICRO_NEGATIVE_EVENT_BLOCK_THRESHOLD=0.85

# In-process local model mode, no local server required:
# LLM_EVENT_PROVIDER=embedded
# LLM_EVENT_MODEL=models/local-llm/event-classifier
# LLM_EVENT_DEVICE=auto
# LLM_EVENT_MODEL_CACHE_DIR=models/local-llm/cache
# LLM_EVENT_LOCAL_FILES_ONLY=true
# LLM_EVENT_MAX_NEW_TOKENS=512

# Multimodal in-process mode for Hugging Face vision-language checkpoints:
# LLM_EVENT_PROVIDER=multimodal
# LLM_EVENT_MODEL=google/diffusiongemma-26B-A4B-it
# LLM_EVENT_DEVICE=auto
# LLM_EVENT_MODEL_CACHE_DIR=models/local-llm/cache
# LLM_EVENT_LOCAL_FILES_ONLY=true
# LLM_EVENT_MAX_NEW_TOKENS=512

# OpenVINO/NPU in-process mode, when optimum-intel/openvino supports the model:
# LLM_EVENT_PROVIDER=openvino-llm
# LLM_EVENT_DEVICE=NPU
# LLM_EVENT_INFERENCE_BACKEND=openvino

# Low-latency inference preference. CPU fallback remains enabled.
ONTOLOGY_ACCELERATOR=NPU
REALTIME_LATENCY_PROFILE=low_latency
OPENVINO_DEVICE=NPU
OPENVINO_HINT_PERFORMANCE_MODE=LATENCY
OPENVINO_ENABLE_CPU_PINNING=YES

# Ontology-gated strategy-owned refactor. All new execution behavior is
# fail-closed and shadow-disabled until its phase acceptance tests pass.
REFACTOR_LEGACY_VOTE_PATH=true
REFACTOR_WEBSOCKET_MARKET_DATA=false
REFACTOR_LOCAL_CHART_ENGINE=false
REFACTOR_ONTOLOGY_ROUTER=false
REFACTOR_GNN_SHADOW=false
# Shadow GNN loads this calibrated checkpoint. It never enables live orders.
REFACTOR_GNN_CHECKPOINT=data/models/strategy_utility/rgcn_shadow.npz
REALTIME_OPERATIONAL_RETENTION_HOURS=24
REALTIME_BROKER_QUOTE_DELAY_SEC=0.35
REALTIME_BROKER_QUOTE_CACHE_TTL_SEC=60
KIS_GLOBAL_GET_INTERVAL_SEC=0.25
REALTIME_ALLOW_LOSS_EXIT=true
REALTIME_STOP_LOSS_NET=0.015
REALTIME_HARD_STOP_LOSS=0.03
REALTIME_EMERGENCY_STOP_LOSS=0.05
REFACTOR_GNN_RERANK=false
REFACTOR_NPU_INFERENCE=false
REFACTOR_STRATEGY_OWNED_EXECUTION=false
REFACTOR_LIVE_ENABLED=false

# Reliability-driven learning/live mode controller. Disabled in the template;
# enable only on a reviewed live deployment.
AUTO_RELIABILITY_MODE_ENABLED=false
AUTO_RELIABILITY_CHECK_SECONDS=15
AUTO_RELIABILITY_PROMOTE_THRESHOLD=0.90
AUTO_RELIABILITY_PROMOTE_CONSECUTIVE=4
AUTO_RELIABILITY_DEMOTE_CONSECUTIVE=2
AUTO_RELIABILITY_MIN_HEALTHY_SYMBOLS=2
AUTO_RELIABILITY_KRX_MIN_HEALTHY_SYMBOLS=1
AUTO_RELIABILITY_US_MIN_HEALTHY_SYMBOLS=2
LIVE_TRAINING_INTERVAL_SECONDS=300
LIVE_TRAINING_MAX_FEATURE_FRAMES=25000
LIVE_TRAINING_BACKFILL_STRIDE_SECONDS=5
LIVE_TRAINING_BACKFILL_MAX_FRAMES=1200
LIVE_TRAINING_BACKFILL_LOOKBACK_HOURS=8
LIVE_KRX_FEATURE_FRAME_ENABLED=true
LIVE_KRX_FEATURE_FRAME_SECONDS=5
LIVE_KRX_FEATURE_FRAME_SYMBOL_LIMIT=4
LIVE_TRAINING_MAX_MATERIALIZED_ROWS=100000
KIS_REALTIME_TRAINING_MIN_PRICE_KRW=500
KIS_REALTIME_SYMBOL_ROTATION_SECONDS=300
KIS_OVERSEAS_REALTIME_ENABLED=true
KIS_OVERSEAS_REALTIME_MAX_SYMBOLS=6
KIS_OVERSEAS_REALTIME_RESUBSCRIBE_SECONDS=120
LIVE_MODEL_BATCH_LOGISTIC_EPOCHS=250
LIVE_MODEL_BATCH_LINEAR_EPOCHS=180
LIVE_MODEL_PROMOTION_MAX_AUC_DROP=0.01
LIVE_MODEL_PROMOTION_MAX_PRECISION_DROP=0.02
LIVE_MODEL_PROMOTION_MAX_RETURN_BPS_DROP=2.0
LIVE_MODEL_PROMOTION_MIN_AUC_GAIN=0.005
LIVE_MODEL_PROMOTION_MIN_PRECISION_GAIN=0.01
LIVE_MODEL_PROMOTION_MIN_RETURN_BPS_GAIN=1.0
AUTO_RELIABILITY_KRX_MAX_AGE_SECONDS=20
AUTO_RELIABILITY_KRX_TRADE_ACTIVITY_MAX_AGE_SECONDS=120
AUTO_RELIABILITY_US_MAX_AGE_SECONDS=90
AUTO_RELIABILITY_MODEL_MAX_AGE_SECONDS=1800
AUTO_RELIABILITY_ACTIVE_MODEL_MAX_AGE_SECONDS=2592000
AUTO_RELIABILITY_LEARNING_REFRESH_SECONDS=300
AUTO_RELIABILITY_US_WARM_SECONDS=15
AUTO_RELIABILITY_US_WARM_SYMBOLS=4
REALTIME_US_WATCHLIST_TTL_SEC=1800
REALTIME_US_WATCHLIST_RECHECK_SEC=300
REALTIME_US_WATCHLIST_MAX_TICK_AGE_SEC=180
REALTIME_US_WATCHLIST_MIN_TICKS=3
REALTIME_US_WATCHLIST_SAMPLE_ROWS=20000
REALTIME_US_LIQUIDITY_SEED_SYMBOLS=F,SOFI,INTC,PFE,T,BAC,WBD,SNAP,PLTR,NIO,RIVN,LCID,NU,CCL,KVUE,LYFT,HOOD
STRATEGY_SESSION_REQUIRE_LIVE_GNN=true
REALTIME_US_WATCHLIST_LOOKBACK_HOURS=6
REALTIME_REQUIRE_SECOND_DATA_FOR_BUY=true
REALTIME_US_REST_SYMBOL_DELAY_SEC=0.4
MACRO_METRIC_RETENTION_DAYS=730
