# Shared local-LLM configuration for news / event sentiment analysis.
#
# Used by BOTH launchers — Windows `run.ps1` and Raspberry Pi
# `packaging/raspberrypi/run.sh` — and loaded by the app itself at startup, so
# the model is configured in ONE place for every machine.
#
# Copy this file to `config/local_llm.env` and edit. Values here are DEFAULTS:
# anything already set in the shell / launcher wins, so it never clobbers an
# explicit override.
#
# Requires a local Ollama server (https://ollama.com). On each machine, once:
#     ollama pull qwen2.5:1.5b-instruct
#     ollama serve            # usually already running as a background service
#
# If Ollama is NOT reachable, the app auto-detects that at startup and falls back
# to the deterministic keyword sentiment classifier — no crash, and no
# torch/transformers needed (the `local` provider uses plain HTTP).

# Provider: "local" = OpenAI-compatible HTTP (Ollama / llama.cpp server).
# Works identically on Raspberry Pi and Windows with no heavy Python deps.
LLM_EVENT_PROVIDER=local

# Shared model — change it once and it applies to both machines.
# qwen2.5:1.5b-instruct is small and fast enough for near-real-time sentiment on
# a Raspberry Pi CPU. For NVIDIA's open model on an 8GB / 64-bit Pi you can use
# `nemotron-mini` instead (slower: seconds per item).
LLM_EVENT_MODEL=qwen2.5:1.5b-instruct

# Ollama's OpenAI-compatible endpoint (change host if Ollama runs on the LAN).
LLM_EVENT_LOCAL_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions

# How many news / disclosure items to classify per source and per refresh.
# Keep these small on a Pi so slow CPU inference does not back up the refresh
# loop. Raise them on a fast desktop for broader coverage.
LLM_EVENT_MAX_ITEMS_PER_SOURCE=3
LLM_EVENT_MAX_ITEMS_PER_RUN=5

# Leave LLM_EVENT_CLASSIFIER_ENABLED unset so the app auto-detects Ollama at
# startup and enables the LLM path only when the server is actually reachable.
# Set it explicitly here only if you want to force the path on or off.
# LLM_EVENT_CLASSIFIER_ENABLED=true
