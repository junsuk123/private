# Raspberry Pi lightweight runtime profile (Phase 8 — OPTIONAL, disabled by default).
#
# The Pi is treated as a LOW-POWER MONITOR / EXECUTION-GUARD node, NOT a primary
# NPU/ontology/training node. This profile disables the heavy Windows/Intel-NPU
# assumptions so the Pi can run a lightweight account/kill-switch/health dashboard.
#
# IMPORTANT: `scripts/arm_live_trading.py` is LIVE-TRADING ARMING (a safety switch),
# NOT "ARM CPU / Raspberry Pi support". Do not confuse the two. See docs/runtime_profiles.md.
#
# Usage (Linux/Pi):  set -a; . config/runtime_profiles/raspberrypi.env; set +a; ./scripts/run_raspberrypi.sh

# --- Disable heavy accelerators / models (Pi has no Intel NPU) ---------------------
ONTOLOGY_ACCELERATOR=CPU
OPENVINO_DEVICE=CPU
LLM_EVENT_CLASSIFIER_ENABLED=false
LLM_EVENT_PROVIDER=disabled
LIVE_SIGNAL_MODEL_INFERENCE_ENABLED=false

# --- Lightweight scope -------------------------------------------------------------
AUTO_START_LIVE_TRAINING=false
AUTO_START_REALTIME_TRADING=false      # monitor-only by default; enable deliberately
ANALYSIS_MARKET_LIMIT=40
ONTOLOGY_FILTER1_TARGET_COUNT=20
SIM_STRATEGY_CANDIDATES=20
SIM_STREAMING_UNIVERSE_LIMIT=20

# --- Low-frequency GUI / polling ---------------------------------------------------
LIVE_REFRESH_SECONDS=30
LEARNING_COLLECTION_INTERVAL_SECONDS=300
REALTIME_TRADING_INTERVAL_MS=5000

# --- Safety: keep live order submission OFF unless explicitly armed on the Pi -------
LIVE_ORDER_SUBMIT_ENABLED=false
KILL_SWITCH_ENABLED=false
REQUIRE_MANUAL_ARMING=true

# Profitability / exit / sizing policies are shared (config/*.yaml); the Pi honors the
# same net-profitability-first gates as the primary node.
