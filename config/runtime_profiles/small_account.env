# Small-account runtime profile (Phase 4/8).
#
# Conservative, profitability-first tuning for a small KRW account. Source this before
# launching (run.ps1 will pick up any REALTIME_* vars already set in the environment).
# These map onto the unified profitability / exit / sizing policies.

# --- Account posture ---------------------------------------------------------------
REALTIME_SMALL_ACCOUNT_MODE=true
REALTIME_SMALL_ACCOUNT_EQUITY_KRW=200000
REALTIME_SMALL_ACCOUNT_MAX_POSITION_WEIGHT=1.25
REALTIME_ONE_SHARE_CASH_BUFFER=1.10
REALTIME_BUY_WEIGHT=0.003

# --- Profitability gate (net-edge floors) ------------------------------------------
REALTIME_MIN_BUY_NET_RETURN_KR=0.008
REALTIME_MIN_BUY_NET_RETURN_US=0.012
REALTIME_MIN_NET_PROFIT_BUFFER_RATE=0.001

# --- Exit policy -------------------------------------------------------------------
REALTIME_QUICK_TAKE_PROFIT_NET=0.012
REALTIME_MIN_NET_PROFIT_EXIT=0.008
REALTIME_PROFIT_LOCK_ARM_NET=0.012
REALTIME_PROFIT_LOCK_GIVEBACK=0.30
REALTIME_STOP_LOSS_NET=0.0
REALTIME_HARD_STOP_LOSS=0.03
REALTIME_EMERGENCY_STOP_LOSS=0.05
REALTIME_ALLOW_LOSS_EXIT=false
REALTIME_BLOCK_SELL_BELOW_BREAKEVEN=true

# --- Daily loss budget -------------------------------------------------------------
REALTIME_DAILY_REALIZED_LOSS_LIMIT_KRW=1500
REALTIME_DAILY_REALIZED_LOSS_BUY_STOP_KRW=1000
REALTIME_DAILY_REALIZED_LOSS_BUY_STOP_RATE=0.004
