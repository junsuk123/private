# One virtual environment per OS: a venv is portable across neither the operating
# system nor the interpreter that built it, and this tree is shared between
# machines through a synced folder.
.venv/
.venv-linux/
.venv-pi/
src/*.egg-info/
packaging/raspberrypi/pi.env
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
data/raw/
data/processed/
data/store/
data/legacy/**/store/

# Rotating training artifacts, not source.
#
# The trainer writes one timestamped file per run - every few minutes while a
# market is open - and 6,000+ of them had accumulated in the index, so every
# commit re-diffed a directory that nothing reads from git. What IS read stays
# tracked: the predictor loads only latest.json / deployment_state.json, and
# ModelArtifactRegistry globs the timestamped ones off the local disk, where they
# remain. Untracking them does not delete them.
data/models/live_short_horizon/**/live_short_horizon.*.json
data/models/realtime_supervised/realtime_supervised_trade_timing.*.json
!data/models/realtime_supervised/realtime_supervised_trade_timing.latest.json
# The context GNN checkpoint is regenerated by the auto-training worker every few hours,
# so tracking it would put a 100KB binary diff in the history on a timer. The lock beside
# it is pure runtime state.
data/models/temporal_hetero_gnn/latest.npz
data/models/temporal_hetero_gnn/.latest.train.lock
*.sqlite3
logs/
# Runtime logs / build artifacts / editor backups must never be tracked.
server.log
*.log
data/runtime/
build/
*.bak
*.bak_*
# One-off patch scripts belong in scripts/migrations, not the repo root.
patch_*.py
.env
.env.*
!.env.example
config/secrets/*
!config/secrets/
!config/secrets/*.example
!config/secrets/README.md
config/principal_protection.json
config/live_trading_safety.json
config/trading_costs.json
config/tradable_universe.json
config/model_training.json
config/realtime_market_data.json
config/order_execution.json
config/local_llm.env

# Local ChatGPT Work -> explicit Codex session receiver. Keep the script and
# example config trackable; exclude real session IDs, reports, state and temps.
.codex-monitor/receiver.env
.codex-monitor/*.json
.codex-monitor/*.md
.codex-monitor/*.log
.codex-monitor/.*
.codex-monitor/incoming/
.codex-monitor/queue/
.codex-monitor/accepted/
.codex-monitor/processed/
.codex-monitor/rejected/
.codex-monitor/failed/
.codex-monitor/results/
.codex-monitor/locks/
!.codex-monitor/work_report_result.schema.json

# Per-machine tool permissions, not project configuration. .claude/settings.json
# is the shared one and stays tracked.
.claude/settings.local.json

# Dry-run and replay reports are run artifacts, not source.
data/reports/
