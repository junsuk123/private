# Raspberry Pi runtime environment (CPU-only, NPU-free).
#
# Copy to `packaging/raspberrypi/pi.env` and edit. `run.sh` sources this file
# automatically when it exists. Values here are DEFAULTS: anything already set
# in your shell wins. Secrets (KIS keys) should stay in
# config/secrets/kis_api_keys.env, not here.

# ---- Web server ----
# Bind to 0.0.0.0 so the dashboard is reachable from other LAN devices.
APP_HOST=0.0.0.0
APP_PORT=8010
APP_ENV=local

# ---- Data (reuse the data already accumulated by the main system) ----
# Leave these at the defaults so the Pi reads/writes the same on-disk layout
# the Windows system produced.
DATA_ENV=realtime
DATA_ROOT=data
REALTIME_STORE_ROOT=data/store

# ---- Accelerator: CPU only. No NPU / OpenVINO on Raspberry Pi. ----
ONTOLOGY_ACCELERATOR=CPU
REALTIME_LATENCY_PROFILE=balanced
ONTOLOGY_NPU_ENABLED=false
# Native Rust screening core is used automatically if built; "auto" falls back
# to the pure-Python implementation when the extension is absent.
ONTOLOGY_FILTER1_NATIVE=auto

# ---- Event classification: deterministic keyword rules (no torch/LLM). ----
# Disable the LLM classifier entirely; the active classifier is chosen by
# EVENT_CLASSIFIER_PROVIDER (keyword is already the built-in default).
LLM_EVENT_CLASSIFIER_ENABLED=false
EVENT_CLASSIFIER_PROVIDER=keyword

# ---- Trading mode ----
# Safe default: read-only. Flip these to go live only after wiring KIS secrets
# and completing scripts/live_readiness_check.py, exactly as on the main system.
TRADING_MODE=read_only
LIVE_TRADING_ENABLED=false
KIS_LIVE_ENABLED=false
KIS_PAPER_TRADING=true
LIVE_ORDER_SUBMIT_ENABLED=false

# ---- Background workers ----
AUTO_START_REALTIME_TRADING=false
AUTO_START_LIVE_TRAINING=true
LIVE_TRAINING_INTERVAL_SECONDS=120
LIVE_REFRESH_SECONDS=15
LEARNING_COLLECTION_INTERVAL_SECONDS=60
RESEARCH_RETENTION_DAYS=30

# ---- Pi-friendly workload sizing (smaller than the NPU desktop profile) ----
ANALYSIS_MARKET_LIMIT=150
ONTOLOGY_FILTER1_TARGET_COUNT=60
SIM_STRATEGY_CANDIDATES=80
SIM_STREAMING_UNIVERSE_LIMIT=80
