# systemd unit for OBAITS (Ontology Based AI Trading System) running CPU-only on a
# Raspberry Pi.
#
# The unit FILE NAME stays personal-investment.service on purpose. It is the
# identity systemd already has for every Pi where this was enabled; renaming it
# here would leave the old unit running on those boxes and the new one never
# installed. The name is deployment state, not documentation.
#
# Install:
#   1. Edit WorkingDirectory / User below to match your checkout and account.
#   2. sudo cp packaging/raspberrypi/personal-investment.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now personal-investment.service
#   5. journalctl -u personal-investment.service -f
#
[Unit]
Description=OBAITS - Ontology Based AI Trading System (Raspberry Pi, CPU-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
# Absolute path to the repository checkout on the Pi:
WorkingDirectory=/home/pi/private
ExecStart=/bin/bash packaging/raspberrypi/run.sh
Restart=on-failure
RestartSec=5
# Keep the box responsive; the CPU pipeline is lightweight but bursty.
Nice=5
TimeoutStopSec=20
KillMode=mixed

[Install]
WantedBy=multi-user.target
